# =============================================================================
# HireLens API configuration
# Copy to backend/.env and fill in the values.
# =============================================================================

# -- Gemini -------------------------------------------------------------------
# Required. Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=models/gemini-flash-lite-latest

# -- Security -----------------------------------------------------------------
# REQUIRED IN PRODUCTION. Without it a new key is generated per process, which
# invalidates every token on restart. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_MIN_LENGTH=10

# -- App ----------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# Comma-separated list of allowed browser origins (the frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -- Database -----------------------------------------------------------------
# SQLite by default. For Postgres:
#   postgresql+asyncpg://user:password@localhost:5432/hirelens
DATABASE_URL=sqlite+aiosqlite:///./hirelens.db
DB_ECHO=false

# -- Analysis limits ----------------------------------------------------------
MAX_FILE_SIZE_MB=10
MAX_BATCH_SIZE=15
MAX_CV_CHARS=30000
MAX_JD_CHARS=15000
ANALYSIS_CONCURRENCY=4

# -- Rate limiting ------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
ANALYSIS_RATE_LIMIT_REQUESTS=10
ANALYSIS_RATE_LIMIT_WINDOW_SECONDS=300
